# Copia este archivo a .env.local para desarrollo y pon los mismos valores en
# Vercel → Settings → Environment Variables (Production y Preview).

# --- Formulario de contacto (/api/lead) -------------------------------------
# API key de Resend (https://resend.com/api-keys). Permiso "Sending access".
RESEND_API_KEY=
# Dónde llegan los leads. Varios destinatarios separados por comas.
LEAD_TO_EMAIL=admin@naraintelligences.com
# Remitente. Su dominio tiene que estar verificado en Resend. Mientras no lo
# esté, usa "Nara Intelligence <onboarding@resend.dev>" (solo entrega al email
# con el que te registraste en Resend).
LEAD_FROM_EMAIL=Nara Intelligence <web@naraintelligences.com>

# --- n8n (opcional) ---------------------------------------------------------
# Si está definida, cada lead se envía también aquí por POST (JSON). Si n8n
# falla, el lead se entrega igualmente por email.
N8N_WEBHOOK_URL=
# Secreto compartido: se manda en la cabecera X-Nara-Secret para que el
# workflow pueda rechazar peticiones que no vengan de la web.
N8N_WEBHOOK_SECRET=

# --- Sitio ------------------------------------------------------------------
# URL canónica (sitemap, robots, Open Graph). Sin barra final.
NEXT_PUBLIC_SITE_URL=https://naraintelligences.com
